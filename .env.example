# End-to-end test suite configuration
#
# Copy this file to `.env` and adjust the values for your Open edX installation:
#
#     cp .env.example .env
#
# Configuration is validated at load time: a missing or malformed value fails
# fast with a clear message instead of a misleading test failure. Only
# `.env.example` is committed — never commit a real `.env`.
#
# **Note:** Actual environment variables take precedence over the values set
#           in .env files!

# --- Base URLs (origins) ---------------------------------------------------
# All origins must share one scheme (all http:// or all https://) and one
# registrable parent domain (e.g. *.local.openedx.io), so a single sign-in
# covers every sub-domain. Do not use `localhost` or IP addresses: they have no
# usable sub-domain structure for shared cookies.

# LMS origin. Required.
LMS_BASE_URL=http://local.openedx.io

# Micro-frontend (MFE) host origin — where the authn, learning, account, etc.
# MFEs are served. Required.
APPS_BASE_URL=http://apps.local.openedx.io

# Studio (CMS) origin. Required when the `studio` capability is declared below;
# otherwise optional and unused. Studio authenticates through the LMS session
# (a silent OAuth handshake — no second sign-in), so no separate credentials.
CMS_BASE_URL=http://studio.local.openedx.io

# --- Credentials -----------------------------------------------------------
# Optional admin/staff account used for staff-role coverage and portable test-
# data seeding. Set both together, or omit both. Learner accounts are created by
# the registration flow rather than configured here.
#
# With `studio` declared, the default account backend also uses this account to
# grant course-creator status to the `author` role's fresh account through the
# Django admin (the only path a default install offers). Without it, `author`
# is only available on installs where every user may create courses
# (ENABLE_CREATOR_GROUP off), and Studio coverage skips otherwise.
# ADMIN_USERNAME=edx
# ADMIN_PASSWORD=change-me

# --- Tenant / content identifiers ------------------------------------------
# Organization short code used when creating or locating content. Optional.
# ORG=OpenedX

# Course the course-completion specs enroll in and work through. Optional: leave
# it unset and those specs skip cleanly. The course itself is a prerequisite of
# the installation, not something the suite creates — import it however your
# install does (on Tutor: `tutor local do importdemocourse`) and put the resulting
# key here. The demo course's key can differ between installs.
# COURSE_KEY=course-v1:OpenedX+DemoX+DemoCourse

# --- Capability declaration ------------------------------------------------
# Comma-separated list of capabilities enabled on your installation. Specs
# tagged with a capability run only when it is enabled. Unknown values, or two
# mutually-exclusive capabilities together, fail validation.
# Known capabilities: mfe-authn, frontend-base, instructor-dashboard, discussions,
# notifications, email-inbox, teams, notes, wiki, cohorts,
# content-libraries, content-libraries-v1, courseware-navigation-sidebar,
# courseware-legacy-navigation, catalog-search, studio, taxonomies,
# authoring-sidebar, upload-agreements, ora, drag-and-drop-v2, pdf-xblock, lti,
# edx-sga, scorm, certificates, analytics, rbac, rbac-global,
# rbac-matrix-parity, rbac-error-view-action, certificate-web-view, special-exams,
# recommender-studio-settings, authz-auto-migration, authz-manual-migration,
# support-url, no-support-url, course-creator-group, multi-org-catalog,
# course-intro-video, codejail.
#
# The stock surfaces and settings are on by default: mfe-authn, frontend-base,
# instructor-dashboard, discussions, notifications, authz-manual-migration,
# no-support-url and course-creator-group. Turn one off with a `-` prefix, e.g.
# for an install whose identity lives in an external service:
# CAPABILITIES=-mfe-authn
# Declaring the other half of a mutually exclusive pair replaces its default-on
# half (`support-url` alone turns `no-support-url` off). A declared capability
# the target lacks fails its specs rather than skipping.
#
# docs/capabilities.md describes every capability: what it means, which specs it
# gates, which Open edX releases are known to support it, and where CI declares
# it (.ci/openedx-releases.json per release).
CAPABILITIES=courseware-navigation-sidebar,catalog-search,studio,taxonomies,authoring-sidebar,wiki,cohorts,teams,ora,drag-and-drop-v2,lti,scorm,edx-sga,pdf-xblock,certificates,content-libraries,content-libraries-v1,rbac

# --- Advanced --------------------------------------------------------------
# For providers whose LMS/Studio/MFE origins are NOT same-site (different
# registrable domains). Requires the install to serve SameSite=None +
# Secure cookies with a CORS whitelist. Leave unset for the standard shared
# parent-domain deployment. Accepts: true/false, 1/0, yes/no.
# ALLOW_CROSS_SITE_ORIGINS=false

# Number of parallel Playwright workers. Defaults to 2 locally and 4 in CI.
# Keep it low against a local Tutor: a busy CMS worker (search indexing after
# every publish) evicts author Studio sessions under higher parallelism, so more
# workers trade throughput for flaky StudioSessionExpiredError failures. Accepts
# a positive integer or a percentage of CPU cores like "50%".
# WORKERS=2

# Set by CI for each shard of a run; leave unset locally. RUN_ID_SUFFIX (up to
# three lowercase letters or digits) is appended to the run id so shards never
# create identically named courses or accounts. CI_PROFILE names the CI profile
# (.ci/profiles.json) the job runs. Both label every result, so a merged report
# can tell shards and profiles apart.
# RUN_ID_SUFFIX=d1
# CI_PROFILE=default

# --- Account creation / activation backend --------------------------------
# How a newly-registered account becomes able to sign in. See issue #10.
#   automatic  (default) Registers a throwaway identity and reuses the session
#              registration itself creates, so it works on a default install
#              even when accounts stay inactive until activation. Only the
#              login/logout specs need an account that can sign in separately
#              (SKIP_EMAIL_VALIDATION=True, or use `manual`).
#   manual     Interactive: the suite prompts for an email to register with and
#              for the activation link/token to paste. For targets that enforce
#              email validation and cannot be reconfigured. Run with --workers=1.
#   <plugin>   The `name` of a custom backend loaded from
#              CUSTOM_ACCOUNT_BACKEND_PLUGINS (see src/accounts/README.md).
# ACCOUNT_BACKEND=automatic

# Comma-separated paths of custom account backend plugin modules to load, each
# default-exporting an AccountBackend (or a class/factory for one). Paths are
# resolved from the working directory and must exist. Defaults to none.
# CUSTOM_ACCOUNT_BACKEND_PLUGINS=./plugins/saml-enterprise.plugin.ts

# --- Example plugin: openinbox --------------------------------------------
# `plugins/openinbox.plugin.ts` (shipped as an example) automates what `manual`
# does by hand: it registers with a disposable https://openinbox.io inbox, waits
# for the Open edX activation email, and visits the link. Use it against a target
# that actually sends activation email. Enable with:
#   CUSTOM_ACCOUNT_BACKEND_PLUGINS=./plugins/openinbox.plugin.ts
#   ACCOUNT_BACKEND=openinbox
# The OpenInbox API requires a paid plan. Required when selected. Inboxes are
# deleted as soon as the activation link has been visited, so a run needs only
# as many concurrent inboxes as it has workers.
# OPENINBOX_API_KEY=
# API root, poll budget and poll interval. Optional.
# OPENINBOX_BASE_URL=https://api.openinbox.io/api
# OPENINBOX_POLL_TIMEOUT_MS=90000
# OPENINBOX_POLL_INTERVAL_MS=3000

# --- Mailbox provider (the `email-inbox` capability) -----------------------
# Where the suite reads e-mail the target sends, for notification-mail coverage.
# A provider is a plugin (see src/mail/README.md); two ship in plugins/:
#   mailpit    A Mailpit catcher the target's SMTP points at (what the Tutor CI
#              workflow runs). Needs MAILPIT_BASE_URL.
#   openinbox  A disposable openinbox.io inbox, for a target that sends real
#              mail to the internet. Needs OPENINBOX_API_KEY (above).
# CUSTOM_MAIL_PROVIDER_PLUGINS=./plugins/mailpit.plugin.ts
# MAIL_PROVIDER=mailpit
# Mailpit's web/API origin, as the machine running the suite reaches it.
# MAILPIT_BASE_URL=http://localhost:8025
# Domain of the addresses the plugin mints, and its poll interval. Optional.
# MAILPIT_DOMAIN=e2e.test
# MAILPIT_POLL_INTERVAL_MS=1000

# --- Registration rate limit (server-side) --------------------------------
# Open edX caps registrations per IP via REGISTRATION_RATELIMIT (default
# "60/7d"). Each run creates several accounts, so frequent runs exhaust it and
# registration fails with HTTP 403 forbidden-request. For repeatedly-tested
# targets, raise it to a short self-resetting window (e.g. REGISTRATION_RATELIMIT
# = "100/m") and restart the LMS. This is a target Django setting, not a suite
# env var. See the README "Registration rate limit" section.
