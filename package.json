{
  "name": "openedx-end-to-end-tests",
  "version": "0.1.0",
  "description": "End-to-end tests for the Open edX Platform, written in Playwright + TypeScript.",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "btr:publish": "node scripts/publish-btr-sheet.mts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "install:browsers": "playwright install --with-deps",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "keywords": [
    "openedx",
    "e2e",
    "playwright",
    "typescript",
    "testing"
  ],
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "eslint-plugin-playwright": "^2.12.2",
    "oxc-parser": "^0.160.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "tldts": "^7.4.19",
    "zod": "^4.6.7"
  }
}
